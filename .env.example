# =============================================================================
#  FusionLite — Daily report by email
#
#  Instructions:
#    1. cp .env.example .env
#    2. fill in the values below
#    3. chmod 600 .env
#
#  Lines starting with # are comments. No quotes are needed.
#  This file is read automatically by src/main.mjs (no flag required).
# =============================================================================

# --- FusionSolar Account ------------------------------------------------------
# Same credentials you use in the FusionSolar app.
# Note: the account must not have two-step verification (2FA):
# the service cannot enter the verification code.
FUSIONSOLAR_USER=user@example.com
FUSIONSOLAR_PASSWORD=your-password

# Authentication host. Usually the default value is fine;
# uncomment only if your account uses a different host.
# FUSIONSOLAR_AUTH_HOST=intl.fusionsolar.huawei.com
# FUSIONSOLAR_AUTH_PORT=32800

# Client identifier (32 hexadecimal characters). If left empty it is generated
# once and saved in var/state.json. It is not the password.
# APP_CLIENT_ID=

# --- Plant --------------------------------------------------------------------
# Name of the plant exactly as it appears in the FusionSolar app
# (comparison ignores case and leading/trailing spaces).
PLANT_NAME=My plant

# Alternatively, you can use the plant DN (takes precedence).
# PLANT_DN=NE=123456789

# --- Report ------------------------------------------------------------------
# Timezone used for the "yesterday" date and for email times.
TIMEZONE=Europe/Rome

# Manual prices in EURO CENTS per kWh. If set, the email adds the "Costs"
# section (cost of consumption, cost of withdrawal, revenue from feed-in,
# savings from self-consumption, net amount). Leave empty to hide them.
# Accepts both 25 and 25,5.
# REPORT_BUY_CENTS=25
# REPORT_SELL_CENTS=12

# Currency symbol used if the server does not return a valid currency.
# REPORT_CURRENCY=€

# --- Email (Gmail) -----------------------------------------------------------
# This is NOT the normal password for your Google account.
#
#   1. Enable two-step verification:
#      https://myaccount.google.com/security
#   2. Create an "App password":
#      https://myaccount.google.com/apppasswords
#      (choose "Other", name it "FusionLite Report")
#   3. You will get a 16-character password like "abcd efgh ijkl mnop": paste it below.
#      Spaces are removed automatically.
#
# If you have a non-Gmail address, you still need a Google account with an app
# password: the service sends mail via smtp.gmail.com.
GMAIL_USER=youremail@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Recipient of the report (can be the same Gmail account or another address).
# You can specify multiple addresses separated by commas.
REPORT_TO=youremail@gmail.com

# Second recipient (optional). If empty, the report is sent only to REPORT_TO.
REPORT_TO_2=

# Sender shown in the email (if omitted, GMAIL_USER is used).
# MAIL_FROM=youremail@gmail.com
